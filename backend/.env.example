# Port for this backend service
PORT=4000

# Use one Google Sheets edit URL to auto-derive both schedule + course CSV export links.
SCHEDULE_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_ID/edit?usp=sharing

# Optional custom mapping CSV if SCHEDULE_URL is not a Google Sheets URL.
COURSE_URL=

# Optional Google Sheet GIDs used when SCHEDULE_URL points to a Google Sheet.
SCHEDULE_GID=0
COURSE_GID=1069732703

# Comma-separated RGB hex values to treat as cancelled class color in sheet cells.
CANCEL_RED_HEXES=FF0000,F44336,E53935,D32F2F,C62828

# Optional CORS origin for your web app; keep * for local testing.
CORS_ORIGIN=*
